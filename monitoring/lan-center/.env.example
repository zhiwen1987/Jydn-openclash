# Copy to .env on the server. Never commit real credentials.
IKUAI_URL=http://10.88.0.1
IKUAI_TOKEN=replace-with-token
PROXY=http://10.88.0.254:7893
PROXY_AUTH=replace-with-proxy-credentials
OPENCLASH_SECRET=replace-with-openclash-secret
CAPABILITY_PROXY_AUTH=replace-with-isolated-proxy-credentials

# Generate independent random values of at least 32 characters. Never reuse
# the OpenClash API secret or commit production values.
SUBSCRIPTION_PUBLISH_TOKEN=replace-with-random-provider-token
SUBSCRIPTION_HMAC_KEY=replace-with-independent-hmac-key

# Start in shadow. Change to automatic only after the shadow acceptance gate.
SUBSCRIPTION_CONTROLLER_MODE=shadow
SUBSCRIPTION_USER_AGENT=clash.meta
SUBSCRIPTION_MAX_RUNTIME_REJECT_PERCENT=10
SUBSCRIPTION_MAX_RELEASES=100
