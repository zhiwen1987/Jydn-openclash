[Unit]
Description=Read-only OpenClash subscription information synchronization
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/clash-stack/production/subscription-info-sync/source_sync.py /opt/clash-stack/production/subscription-info-sync/config.json
TimeoutStartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/dpanel/compose/lan-center/data/failover/subscription-usage
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CPUQuota=10%
MemoryMax=64M
