[Unit]
Description=Clash geodata candidate collection and native trial
After=docker.service
Requires=docker.service
StartLimitIntervalSec=21600
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec clash-center python3 -B /data/geodata-trial/geodata_trial.py --state /data/geodata-trial/state
TimeoutStartSec=12min
Nice=19
IOSchedulingClass=idle
UMask=0077
Restart=on-failure
RestartSec=15min
