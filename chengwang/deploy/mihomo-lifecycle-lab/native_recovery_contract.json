{
  "schema": "chengwang.mihomo-native-recovery-contract/v5",
  "scope": "ACTUAL_OWNED_KERNEL_RECOVERY_STARTED_RECORD_NOT_HTTP_COMPLETION_OR_PRODUCTION",
  "tags": [
    "chengwang_mihomo_service",
    "chengwang_mihomo_faults",
    "chengwang_mihomo_recovery_native"
  ],
  "goPackage": "./internal/mihomodeploy",
  "topTests": [
    "TestLabRecoveryNativeUnknownStartedReplayReopenAndOwnedCleanup"
  ],
  "goTimeoutSeconds": 75,
  "outerGoTimeoutSeconds": 90,
  "privateRoot": "/tmp/chengwang-mihomo-recovery-private",
  "identityRoot": "/tmp/chengwang-mihomo-service-identities",
  "servicePrivateRoot": "/tmp/chengwang-mihomo-service-private",
  "stateRoot": "/tmp/chengwang-mihomo-service-state",
  "stages": [
    "planned",
    "approved",
    "stop-armed",
    "quiesced",
    "start-armed",
    "started",
    "verification-attempted"
  ],
  "reopenStage": "reopened",
  "counterEventLimit": 256,
  "cleanupPorts": [28411, 28412, 28413, 28414, 28415],
  "fixtureRoles": ["origin", "A", "B"],
  "cleanupProbeKeys": ["port", "attempted", "result"],
  "fixtureCleanupKeys": ["role", "shutdownReturned", "serveReturned", "forcedConnectionsClosed", "errorClass"],
  "recoveryCaptureStage": "recovery-s2",
  "recoveryCaptureFiles": ["transcript.json", "body-1.json", "body-2.json", "body-3.json", "body-4.json", "body-5.json", "body-6.json", "body-7.json", "body-8.json", "verification.json", "local-marker.json"],
  "recoveryCaptureMaxBytes": 2097152,
  "recoveryCaptureBodyBytes": 262144,
  "recoveryVerificationBytes": 65536,
  "recoveryControlOnly": false,
  "recoveryLocalMarkerOnly": true,
  "recoveryLocalMarkerBytes": 65536,
  "recoveryLocalMarkerSchema": "chengwang.mihomo-recovery-local-marker/v1",
  "recoveryLocalMarkerPhase": "RECOVERY_NEW_EPOCH_MARKER",
  "recoveryLocalMarkerScope": "ACTUAL_LOOPBACK_PROXY_MARKER_NOT_INTERNET_BUSINESS_OR_AUTHORIZATION",
  "localMarkerBodyIndependentlyProven": false,
  "verificationModes": ["positive", "not-committed", "unknown", "readback"],
  "verificationRecordPublic": "recovery-s2-record.json",
  "verificationRecordSchema": "chengwang.mihomo-native-verification-record/v1",
  "verificationRecordScope": "REDACTED_ACTUAL_WAL_FACT_NOT_AUTHORIZATION_OR_COMPLETE_PRIVATE_RECEIPT",
  "verificationRecordMaxBytes": 65536,
  "eventCheckpoints": [
    "before-permit-cap-replay",
    "after-permit-cap-replay",
    "before-runner-replay",
    "after-runner-replay",
    "before-cleanup",
    "after-cleanup",
    "before-cleanup-replay",
    "after-cleanup-replay",
    "before-reopen",
    "after-reopen"
  ],
  "eventCheckpointKeys": ["stage", "count", "lastSequence", "eventsSHA256"],
  "eventPrefixEncoding": "Go-json.Marshal([]labNativeRecoveryCall)-sequence-kind-core-at-no-newline",
  "commandReceiptSchema": "chengwang.mihomo-native-command-receipt/v1",
  "commandReceiptKeys": ["schema", "sequence", "sourceCommit", "commandClass", "argv", "cwd", "timeoutSeconds", "exitCode", "observed", "namespace"],
  "commandClasses": ["SANDBOX", "GO_VERSION", "GOFMT", "GO_TEST"],
  "commandReceiptLimit": 4,
  "processEventsSchema": "chengwang.mihomo-apply-private-process-event/v1",
  "processEventLimit": 64,
  "maxPublicBytes": 16777216,
  "production": false,
  "httpRecoveryProven": false,
  "completionProven": false,
  "syntaxRawStreamsIndependentlyProven": false
}
