{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengwang.invalid/schemas/supply-chain-policy-v1.json",
  "title": "Chengwang candidate supply-chain policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "issuedAt",
    "expiresAt",
    "maxEvidenceAgeSeconds",
    "maxFutureSkewSeconds",
    "expectedImageRepository",
    "expectedImageDigest",
    "expectedIssuer",
    "expectedSubject",
    "allowedBuilderIds",
    "allowedPredicateTypes",
    "allowedSignatureAlgorithms",
    "expectedVerifier",
    "expectedTrustRootDigest",
    "expectedRunId",
    "requireTransparencyLog"
  ],
  "properties": {
    "schema": { "const": "chengwang.supply-chain-policy/v1" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxEvidenceAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
    "maxFutureSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "expectedImageRepository": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expectedImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expectedIssuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expectedSubject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "allowedBuilderIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "allowedPredicateTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "allowedSignatureAlgorithms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["ECDSA_P256_SHA256", "ED25519"] }
    },
    "expectedVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "binaryDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "binaryDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "expectedTrustRootDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expectedRunId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "requireTransparencyLog": { "const": true }
  }
}
