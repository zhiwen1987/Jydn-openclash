{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Chengwang deterministic non-executable nft plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "candidate", "network", "runtimeBinding", "nftObjectSha256", "nft", "allowset", "rollback", "globalImpact"],
  "properties": {
    "schema": {"const": "chengwang.m2b-egress-bootstrap-plan/v1"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["projectName", "serviceName", "imageId", "composeSha256", "resolverMode"],
      "properties": {
        "projectName": {"type": "string"}, "serviceName": {"type": "string"},
        "imageId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "composeSha256": {"$ref": "#/$defs/sha256"},
        "resolverMode": {"const": "DIRECT_DOT_ONLY_NO_SYSTEM_RESOLVER"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "driver", "internal", "attachable", "bridgeName", "enableIcc", "enableIpv6", "ipv4", "ipv6", "runtimeCollisionCheckRequired"],
      "properties": {
        "name": {"type": "string"}, "driver": {"const": "bridge"}, "internal": {"const": false}, "attachable": {"const": false},
        "bridgeName": {"type": "string"}, "enableIcc": {"const": false}, "enableIpv6": {"const": true}, "ipv4": {"$ref": "#/$defs/networkFamily"},
        "ipv6": {"$ref": "#/$defs/networkFamily"}, "runtimeCollisionCheckRequired": {"const": true}
      }
    },
    "runtimeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "bootstrapMechanism", "required", "sourceAddressFallbackIsNotIdentityProof"],
      "properties": {
        "status": {"const": "BLOCKED_NO_RUNTIME_IDENTITY_BEFORE_PROCESS_START"},
        "bootstrapMechanism": {"const": "INDEPENDENT_NETNS_OR_PAUSED_NO_NETWORK_SHIM_REQUIRED"},
        "required": {"const": ["containerId", "containerPid", "pidStartTime", "netnsInode", "cgroupId", "vethHostIfindex", "networkId", "bridgeIfindex", "bootId", "containerResolvConfSha256"]},
        "sourceAddressFallbackIsNotIdentityProof": {"const": true}
      }
    },
    "nftObjectSha256": {"$ref": "#/$defs/sha256"},
    "nft": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "table", "baseChains", "policyChains", "rules", "forwardDefaultDenyForManagedBridge", "hostInputDefaultDenyForManagedBridge", "globalDefaultPolicyChanged"],
      "properties": {
        "family": {"const": "inet"}, "table": {"type": "string"},
        "baseChains": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/baseChain"}},
        "policyChains": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "rules": {"type": "array", "minItems": 15, "maxItems": 160, "items": {"$ref": "#/$defs/rule"}},
        "forwardDefaultDenyForManagedBridge": {"const": true}, "hostInputDefaultDenyForManagedBridge": {"const": true},
        "globalDefaultPolicyChanged": {"const": false}
      }
    },
    "allowset": {
      "type": "object", "additionalProperties": false,
      "required": ["plainDns", "dot", "https", "sharedDestinationAttribution", "validationUnix", "resolverObservedUnix", "resolverExpiresUnix", "canaryContractSha256", "canaryObservedUnix", "canaryExpiresUnix"],
      "properties": {
        "plainDns": {"const": []},
        "dot": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/dot"}},
        "https": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/https"}},
        "sharedDestinationAttribution": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/shared"}},
        "validationUnix": {"type": "integer", "minimum": 1}, "resolverObservedUnix": {"type": "integer", "minimum": 1},
        "resolverExpiresUnix": {"type": "integer", "minimum": 1}, "canaryContractSha256": {"$ref": "#/$defs/sha256"},
        "canaryObservedUnix": {"type": "integer", "minimum": 1}, "canaryExpiresUnix": {"type": "integer", "minimum": 1}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "family", "table", "managedChains", "expectedNftObjectSha256", "preconditions", "automaticExecutionPermitted"],
      "properties": {
        "operation": {"const": "DELETE_ONLY_EXACT_MANAGED_TABLE"}, "family": {"const": "inet"}, "table": {"type": "string"},
        "managedChains": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "expectedNftObjectSha256": {"$ref": "#/$defs/sha256"},
        "preconditions": {"const": ["sameBootId", "sameNftObjectSha256", "sameTableDigest", "sameRuntimeIdentityBinding", "noForeignObjectsInManagedTable"]},
        "automaticExecutionPermitted": {"const": false}
      }
    },
    "globalImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["scopeClaim", "hostBaseChainInventoryRequired", "otherBaseChainOrderingMayOverrideOrBypassPlan", "dockerManagedRulesInteractionUnproven", "approval"],
      "properties": {
        "scopeClaim": {"const": "ONLY_TRAFFIC_ON_EXACT_MANAGED_BRIDGE"}, "hostBaseChainInventoryRequired": {"const": true},
        "otherBaseChainOrderingMayOverrideOrBypassPlan": {"const": true}, "dockerManagedRulesInteractionUnproven": {"const": true},
        "approval": {"const": "unproven"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "networkFamily": {
      "type": "object", "additionalProperties": false, "required": ["subnet", "gateway", "containerAddress"],
      "properties": {"subnet": {"type": "string"}, "gateway": {"type": "string"}, "containerAddress": {"type": "string"}}
    },
    "baseChain": {
      "type": "object", "additionalProperties": false, "required": ["name", "hook", "priority", "policy"],
      "properties": {"name": {"type": "string"}, "hook": {"enum": ["forward", "input"]}, "priority": {"type": "integer"}, "policy": {"const": "accept"}}
    },
    "match": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "all": {"const": true},
        "iifname": {"type": "string"}, "oifname": {"type": "string"}, "nfproto": {"enum": ["ipv4", "ipv6"]},
        "source": {"type": "string"}, "sourceNot": {"type": "string"}, "protocol": {"enum": ["tcp", "udp", "ipv6-icmp"]},
        "sourceSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "destination": {"type": "string"}, "destinationPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "icmpv6Type": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "hopLimit": {"type": "integer", "minimum": 0, "maximum": 255},
        "ctState": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["new", "established", "related", "invalid"]}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["chain", "ordinal", "kind", "match", "counterLabel", "verdict"],
      "properties": {
        "chain": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 10, "multipleOf": 10}, "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "match": {"$ref": "#/$defs/match"}, "counterLabel": {"type": "string", "pattern": "^cw:[a-z0-9-]+:[0-9]{4}:[0-9a-f]{10}$"},
        "verdict": {"type": "string", "pattern": "^(accept|drop|jump:[A-Za-z_][A-Za-z0-9_]{0,31})$"},
        "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dot": {
      "type": "object", "additionalProperties": false, "required": ["serverName", "address", "port", "transport"],
      "properties": {"serverName": {"type": "string"}, "address": {"type": "string"}, "port": {"const": 853}, "transport": {"const": "tcp-tls"}}
    },
    "https": {
      "type": "object", "additionalProperties": false, "required": ["id", "host", "port", "addresses"],
      "properties": {"id": {"type": "string"}, "host": {"type": "string"}, "port": {"const": 443}, "addresses": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "shared": {
      "type": "object", "additionalProperties": false, "required": ["address", "probeIds"],
      "properties": {"address": {"type": "string"}, "probeIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}}
    }
  }
}
