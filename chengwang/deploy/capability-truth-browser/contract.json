  "domRules": {
    "capabilityTime": "generatedAtLabel exact 清单生成时间; browser timeZone UTC; parse observed normalized Chinese numeric calendar fields and compare actual RFC3339 components. Raw expected string must not come from driver formatter; freeze allowable separators/hour width before implementation",
    "demo": "demo alert and source labels remain; mode equals actual snapshot.mode in topbar and overview; badge 总览只读 and permission boundary exact; no seed business/pool/event/metric widgets or simulated topology/observed DNS health",
    "fence": "captureCount is settled capture prefix; snapshotCaptureOrdinal and capabilitiesCaptureOrdinals must exactly equal API bodies present in prefix. Checker derives latest actual response from prefix and graph; ordinals declare observation position, not app consumption proof. Need independent full DOM-to-body equality.",
    "kernels": "source-frozen4rows/matrix/evidencefields, actual unknown/planning labels;7main actions disabled, no installed/running/ready runtime inference",
    "normalState": "no deadline/pending fault assertions from fast successful API; no token/current user authorizations",
    "png": "6 actual PNGs with exactly corresponding dimensions/hash/bytes/step/scroll, <=4MiB each; viewport screenshot not all rows visibility; independent visual review stays false"
  },
  "domSemantics": {
    "activePage": "page is observed active navigation accessible label; h1 must equal same name, pageMounted/pageVisible from actual main heading. Only active page payload nonnull. Hidden Subscriptions is never operated.",
    "apiFence": "Metadata only, captureCount exact settled prefix. Independent checker derives snapshot+capability ordinals from actual captures and verifies arrays; not proof of React consumption without DOM-to-body equality.",
    "capabilities": "All18 actual article IDs/names/classes/state/readOnly text/evidence/limitations must match latest captured raw API. Summary stateClass is actual child className (currently empty string), not synthesized capability-state enum; fixed summary order establishes association. Actual group DOM first-appearance order and counts. Do not substitute fixture text for observed DOM.",
    "controls": "11 fixed slots; absent => label/labelSourcenull, all booleansfalse,rectnull. Present label prefers actual nonempty aria-label else actual visible innerText. labelSource ARIA_LABEL/VISIBLE_TEXT/null. Native nav requires ARIA_LABEL. Disabled kernel controls may be belowfold; no universal inViewport requirement. Clicked nav/refresh must enabled/visible/inViewport/unobstructed.",
    "geometry": "rect exact finite x/y/width/height, width,height>=0. visible computed ancestor styles+rect; inViewport intersection; unobstructed uses actual elementFromPoint for center inside viewport. Only controls/topbar have geometry; DOM mounted content belowfold and viewport PNGs do not prove every row visible.",
    "kernels": "Four actual table rows as six-key objects; statusClass from real status node; 12 matrix rows feature plus3 cells text/className; six dl dt/dd evidenceFields pairs. Lifecycle design text is not runtime evidence. All7 actions disabled.",
    "limits": "DOM2MiB total,256KiB/row, text strings <=2048UTF16 unless API tighter; source top headings <=160; item/group counts exactly current18, hard cap256. Reject control/bidi unsafe characters, not strip silently.",
    "overview": "Actual DemoOverview extraction: status from direct heading-p text node; mode/badge from first evidence-strip cell; boundaryText from heading p final span; alerts from actual strong/span. Four evidence-strip entries and five boundary rows exact observed text. Evidence status class is actual status node class. Six absence booleans from actual known mounted widget selectors; not arbitrary universal no-fabrication theorem.",
    "scope": "driver.scope actual ManagementScope object, equal independent A runtime projection. default empty tenant/site,candidate/control-plane/local; configured capability-truth-lab/isolated,candidate/control-plane/local. Fixture configured scope only, not authenticated or authorized current user.",
    "time": "Observe actual zh-CN navigator.language and Intl resolved UTC. Capture displayed generatedAtText verbatim normalized whitespace. Independent checker parses numeric calendar fields with allowed / or - date separators, space date/time separator and : clock, one/two-digit month/day/hour, four-digit year and two-digit minute/second, compare actual raw RFC3339 UTC components; no driver-created expected timestamp.",
    "topbar": "Four fields remain product/sourceLabel/mode/kernel, each node {text,visible,rect}. Observed normalized textContent allows truthful hidden mobile node text; hidden => visiblefalse/rectnull. Never interpret hidden text as accessible or visible. Existing HEAD already has nav ARIA/title; no product edit required."
  },
