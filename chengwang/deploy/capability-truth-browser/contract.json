    "count": "1 DOCUMENT + actual reachable manifest assets + exactly1 SNAPSHOT + exactly2 CAPABILITIES",
    "kindEnum": [
      "DOCUMENT",
      "ASSET",
      "SNAPSHOT",
      "CAPABILITIES"
    ],
    "methods": "GET only",
    "origin": "https://127.0.0.1:17891 only",
    "rejectedOrFailed": "any forbidden method/origin/API/safety field, request failure, duplicate identity, missing RESPONSE/FINISH, unfinished graph, journal overflow/rejection => reject; no zero-fill",
    "requestGraph": "REQUEST→HEADERS→FINISH→CAPTURE per alias, allowing interleaving; completion captureOrdinal is assigned synchronously on FINISH in event order, not body promise settlement; exact captured bytes/hash crosslinks; NET_FAIL is distinct failed terminal and always rejects; no active pending/tasks on final sole META",
    "requestId": "anonymous alias r + contiguous requestOrdinal, e.g. r1; original CDP request ID remains private same-session map only",
    "requestPublic": null,
    "secretPolicy": "no raw request headers, tokens, private key, Authorization body; asset Bearer literal is source content, not a runtime header; scan actual generated secrets privately before export",
    "status": 200,
    "terminal": "FINISH required, encodedDataLength integer>=0, not a body-size equality guarantee"
  },
