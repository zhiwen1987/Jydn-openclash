    "maxRowUTF8Bytes": 1024,
    "maxRows": 512,
    "meta": "exactly final unique META after normal close/wait; requests/headers/finished/failed/captured = reconstructed sets, pending0/tasks0/mutations0/overflowfalse; unknown/postMETA/duplicate/missing graph => reject",
    "method": "GET/OTHER only, OTHER rejects",
    "mimeClass": [
