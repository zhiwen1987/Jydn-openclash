{
  "schema": "chengwang.ci-ui-dependencies-contract/v2",
  "scope": "TRUSTED_CI_DEPENDENCY_READBACK_NOT_REPRODUCIBLE_PACKAGE_PROVENANCE",
  "reportSchema": "chengwang.ci-ui-dependencies/v2",
  "reportFile": "ci-dependencies.json",
  "platform": {"system": "Linux", "runner": "Linux", "ubuntu": "24.04", "architecture": "amd64"},
  "packages": ["libnss3-tools", "fonts-noto-cjk"],
  "acquireOptions": ["Acquire::Retries=1", "Acquire::http::Timeout=15", "Acquire::https::Timeout=15"],
  "updateStrictOption": "APT::Update::Error-Mode=any",
  "updateTimeoutSeconds": 120,
  "installTimeoutSeconds": 240,
  "killAfterSeconds": 15,
  "readbackCommandTimeoutSeconds": 5,
  "updateInvocations": 1,
  "installInvocations": 1,
  "sourceConfigurationModified": false,
  "privateSourcePolicy": {
    "hostSourcePath": "/etc/apt/sources.list.d/ubuntu.sources",
    "hostSourceBytes": 2995,
    "hostSourceSHA256": "4508181e0dd5578c33d1247db48ab4847910b25da85e0789c8e7b3140d1fb289",
    "hostMirrorURI": "mirror+file:/etc/apt/apt-mirrors.txt",
    "hostMirrorBytes": 144,
    "hostMirrorSHA256": "e0d6b0af979e4662d16357a27ae456cc6f21e26da031540f4df8706ebed1d583",
    "privateDirectoryPattern": "/tmp/chengwang-ci-apt-[a-z0-9_]{8}",
    "sourceFile": "ubuntu.sources",
    "mirrorFile": "mirrors.txt",
    "emptySourceParts": "sourceparts",
    "mirrorCandidates": [
      "https://archive.ubuntu.com/ubuntu/",
      "https://security.ubuntu.com/ubuntu/",
      "http://azure.archive.ubuntu.com/ubuntu/"
    ],
    "suites": ["noble", "noble-updates", "noble-backports", "noble-security"],
    "components": ["main", "restricted", "universe", "multiverse"],
    "signedBy": "/usr/share/keyrings/ubuntu-archive-keyring.gpg",
    "effectiveConfigurationChanged": true,
    "modifyHostConfiguration": false,
    "exportRawSourceContents": false,
    "reusePublishedPackageCache": false
  },
  "securityOptions": [
    "APT::Get::AllowUnauthenticated=false",
    "Acquire::AllowInsecureRepositories=false",
    "Acquire::AllowDowngradeToInsecureRepositories=false",
    "Acquire::Check-Date=true",
    "Acquire::Check-Valid-Until=true",
    "Acquire::https::Verify-Peer=true",
    "Acquire::https::Verify-Host=true",
    "Acquire::https::archive.ubuntu.com::Verify-Peer=true",
    "Acquire::https::archive.ubuntu.com::Verify-Host=true",
    "Acquire::https::security.ubuntu.com::Verify-Peer=true",
    "Acquire::https::security.ubuntu.com::Verify-Host=true",
    "Acquire::https::azure.archive.ubuntu.com::Verify-Peer=true",
    "Acquire::https::azure.archive.ubuntu.com::Verify-Host=true"
  ],
  "unsetEnvironment": ["APT_CONFIG"],
  "extraSourcesProbe": {
    "binary": "/usr/bin/apt-config",
    "options": ["APT::Config::Dump::EmptyValue=false"],
    "arguments": ["dump", "APT::Sources::With", "Binary::apt-get::APT::Sources::With"],
    "timeoutSeconds": 5,
    "maxBytes": 4096,
    "emptyOutputRequired": true,
    "exportRawOutput": false
  },
  "aptVersionCommand": ["/usr/bin/apt-get", "--version"],
  "aptVersionLog": "ci-dependency-toolchain.log",
  "aptVersionMaxBytes": 16384,
  "fontFamily": "Noto Sans CJK SC",
  "fonts": [
    {"style": "Regular", "path": "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"},
    {"style": "Bold", "path": "/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc"}
  ],
  "certutilPath": "/usr/bin/certutil",
  "maxLogBytes": 4194304,
  "maxFontBytes": 67108864,
  "production": false
}
